# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/

# Environment variables
.env

# Editor & IDE settings
.vscode/
.idea/

# Local session saves and generated reports (keep directories via .gitkeep)
data/saves/*.pkl
data/reports/*.png
!data/saves/.gitkeep
!data/reports/.gitkeep
!data/notes/.gitkeep